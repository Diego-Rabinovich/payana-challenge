# ============================================================================
#  Copy to .env and fill in. Never commit .env.
# ============================================================================

# ---------- Application ----------
NODE_ENV=development
LOG_LEVEL=info
# Business timezone: decides which day a movement belongs to.
TZ=America/Bogota
PORT=3100

DATA_DIR=./data
CONFIG_DIR=./config

# ---------- Persistence ----------
DATABASE_URL=postgres://aa:aa@localhost:5433/aa_conciliacion

# ---------- Wompi ----------
# Panel > Configuraciones avanzadas para programadores.
# Live account (pub_prod_/prv_prod_). Reading is the intended use; do not
# change the events URL and do not rotate keys.
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PRIVATE_KEY=

# ---------- Odoo (ERP) ----------
ODOO_URL=https://payana-prod.odoo.com
ODOO_DB=
ODOO_USER_ID=10
ODOO_API_KEY=
ODOO_COMPANY_ID=2

# Reads are unrestricted. Creating a draft entry from the console needs this.
ODOO_WRITE_ENABLED=false

# ---------- Challenge accounts ----------
BANCOLOMBIA_ACCOUNT_NUMBER=00000000000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:3100/api/v1
