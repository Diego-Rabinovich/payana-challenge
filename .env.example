# ============================================================================
#  Copy to .env and fill in. Never commit .env.
#  With SOURCE_MODE=fixtures the whole system runs with no credentials.
# ============================================================================

# ---------- Application ----------
NODE_ENV=development
LOG_LEVEL=info
# Business timezone: decides which day a movement belongs to.
TZ=America/Bogota
PORT=3000

# fixtures = read from data/fixtures (offline, deterministic)
# live     = hit Wompi and Odoo for real
SOURCE_MODE=fixtures

DATA_DIR=./data
CONFIG_DIR=./config
RULESET_PATH=./config/ruleset.v1.json

# ---------- Persistence ----------
DATABASE_URL=postgres://aa:aa@localhost:5432/aa_conciliacion

# ---------- Wompi ----------
# Panel > Configuraciones avanzadas para programadores.
# Live account (pub_prod_/prv_prod_). Reading is the intended use; do not
# change the events URL and do not rotate keys. See ADR-0012.
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Validates the SHA-256 checksum in the X-Event-Checksum webhook header.
WOMPI_EVENTS_SECRET=
# Only used to CREATE payments. We do not need it.
WOMPI_INTEGRITY_SECRET=

# Settlement report delivery over SFTP, if available. See Q1.3.
WOMPI_SFTP_HOST=
WOMPI_SFTP_USER=
WOMPI_SFTP_PASSWORD=
WOMPI_SFTP_PATH=

# ---------- Odoo (ERP) ----------
ODOO_URL=https://payana-prod.odoo.com
ODOO_DB=
ODOO_USER_ID=10
ODOO_API_KEY=
ODOO_COMPANY_ID=2
# 48 = Wompi Tarjetas (bank acct 1110001, suspense 1010001)
ODOO_JOURNAL_WOMPI=48
ODOO_JOURNAL_BANCOLOMBIA=49

# Reads are unrestricted. Creating entries needs this plus --confirm.
ODOO_WRITE_ENABLED=false

# ---------- Challenge accounts ----------
BANCOLOMBIA_ACCOUNT_NUMBER=00000000000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:3000/api/v1
