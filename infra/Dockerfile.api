# Multi-stage: the runtime image carries no toolchain and no source.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/cli ./apps/cli
RUN pnpm install --frozen-lockfile

FROM node:22-alpine
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production
ENV PORT=3100
EXPOSE 3100
COPY --from=build /app ./
# The API runs from TypeScript source via tsx: for a system this size a build
# step would add a failure mode without removing one.
CMD ["pnpm", "--filter", "@aa/api", "exec", "tsx", "src/main.ts"]
